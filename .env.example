# Chave da API da Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Configuração escolhida para o showcase no free tier (8 000 tokens/min POR modelo).
# Dividir agente e skills entre dois modelos dobra o orçamento: análise completa 129 s → 20 s.

# Agente (decide a skill e escreve a resposta). Precisa de tool calling.
GROQ_MODEL=openai/gpt-oss-20b

# Chamadas internas das skills (format_checker / cv_scorer, generateObject).
# Só o 120b passou nos testes de 2026-10-03 (20b e qwen falharam no schema/limite de saída).
GROQ_SKILL_MODEL=openai/gpt-oss-120b

# Rodadas de web search do role_matcher (built-in tool "browser_search").
# O 20b não conseguiu sintetizar o JSON final; mantenha o 120b.
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
