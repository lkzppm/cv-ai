# Chave da API da Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo principal do agente (precisa suportar tool calling)
# Opções testadas: openai/gpt-oss-120b (padrão, com reasoning), llama-3.3-70b-versatile, moonshotai/kimi-k2-instruct-0905
GROQ_MODEL=openai/gpt-oss-120b

# Modelo usado pela skill role_matcher para as rodadas de web search.
# Precisa suportar a built-in tool "browser_search" da Groq: openai/gpt-oss-120b ou openai/gpt-oss-20b
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
